{
  "name": "bake",
  "version": "0.1.0",
  "description": "Developer tool for Cookie Chain (SVM/Solana-compatible blockchain)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bake": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.0",
    "@solana/web3.js": "^2.0.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "conf": "^10.1.0",
    "ora": "^8.1.0",
    "picocolors": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  },
  "keywords": ["solana", "svm", "cli", "cookie-chain", "anchor"],
  "license": "MIT"
}
